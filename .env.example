# LazUs — Local Environment Variables Template
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# PostgreSQL Local (Docker)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lazus_db"

# Server / Worker API
PORT=8787
APP_BASE_URL="http://localhost:5173"

# Cloudflare R2 / Object Storage (Development placeholders)
R2_BUCKET_NAME="lazus-media-dev"

# Web Push (VAPID) — Generate using `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:support@lazus.app"
