# LazUs Environment Variables Example
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lazus_db"
ENVIRONMENT="development"
APP_BASE_URL="http://localhost:5173"

# Auth & Crypto
AUTH_SECRET="lazus_super_secret_auth_signing_key_min_32_bytes_long"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email Service
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="LazUs <onboarding@resend.dev>"
