{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lazus",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUPLE_ROOM",
        "class_name": "CoupleDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CoupleDurableObject"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  }
}
